# Postgres
POSTGRES_DB=dicom
POSTGRES_USER=dicom
POSTGRES_PASSWORD=change-me

# Django
DJANGO_SECRET_KEY=change-me-too
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orthanc (internal basic auth, used by Django to talk to Orthanc - not exposed publicly)
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=change-me-orthanc
ORTHANC_URL=http://orthanc:8042

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_OHIF_BASE_URL=http://localhost:3030

# CORS (frontend + OHIF viewer origins allowed to call the Django API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3030

# Argo Workflows (MONAI segmentation pipeline). Requires a local Kubernetes
# cluster with Argo Workflows installed - see cluster/README.md. Django talks
# directly to the Kubernetes API server to create/poll Workflow custom
# resources (not to Argo Server's own REST API - its Service isn't reachable
# from other Docker containers on Docker Desktop).
# Generate ARGO_TOKEN with: kubectl create token default -n argo --duration=87600h
ARGO_SERVER_URL=https://kubernetes.docker.internal:6443
ARGO_TOKEN=change-me
